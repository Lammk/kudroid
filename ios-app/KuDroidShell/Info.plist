<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>KuDroid</string>
    <key>CFBundleName</key>
    <string>KuDroid</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>KuDroid lets guest Android applications reach devices on your local network.</string>
    <key>NSCameraUsageDescription</key>
    <string>KuDroid needs camera access for guest Android applications.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>KuDroid needs microphone access for guest Android applications and audio recording.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>KuDroid needs photo library access to import/export media files with Android apps.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>KuDroid needs Bluetooth access to connect wireless game controllers.</string>
</dict>
</plist>
