<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>KuDroid</string>
    <key>CFBundleDisplayName</key>
    <string>KuDroid</string>
    <key>CFBundleVersion</key>
    <string>14</string>
    <key>CFBundleShortVersionString</key>
    <string>T1.4</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60@2x</string>
                <string>AppIcon60x60@3x</string>
                <string>AppIcon</string>
            </array>
            <key>UIPrerenderedIcon</key>
            <false/>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60@2x</string>
                <string>AppIcon</string>
            </array>
            <key>UIPrerenderedIcon</key>
            <false/>
        </dict>
    </dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array><dict>
        <key>CFBundleURLName</key><string>KuDroid App Launch</string>
        <key>CFBundleURLSchemes</key><array><string>kudroid</string></array>
        <key>CFBundleTypeRole</key><string>Viewer</string>
    </dict></array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Android Application Package</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.android.package-archive</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>apk</string>
			</array>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>icon.png</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Android APK Bundle</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.kudroid.android.apkm</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>apkm</string>
			</array>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>icon.png</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Android Expansion Package</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.kudroid.android.xapk</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>xapk</string>
			</array>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>icon.png</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Android Split Package</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.kudroid.android.apks</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>apks</string>
			</array>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>icon.png</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.android.package-archive</string>
			<key>UTTypeDescription</key>
			<string>Android Application Package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apk</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.android.package-archive</string>
				</array>
			</dict>
			<key>UTTypeIconFiles</key>
			<array>
				<string>icon.png</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.kudroid.android.apkm</string>
			<key>UTTypeDescription</key>
			<string>Android APK Bundle</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apkm</string>
				</array>
			</dict>
			<key>UTTypeIconFiles</key>
			<array>
				<string>icon.png</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.kudroid.android.xapk</string>
			<key>UTTypeDescription</key>
			<string>Android Expansion Package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>xapk</string>
				</array>
			</dict>
			<key>UTTypeIconFiles</key>
			<array>
				<string>icon.png</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.kudroid.android.apks</string>
			<key>UTTypeDescription</key>
			<string>Android Split Package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apks</string>
				</array>
			</dict>
			<key>UTTypeIconFiles</key>
			<array>
				<string>icon.png</string>
			</array>
		</dict>
	</array>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>stikdebug</string>
        <string>apple-magnifier</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>KuDroid lets guest Android applications reach devices on your local network.</string>
    <key>NSCameraUsageDescription</key>
    <string>KuDroid needs camera access for guest Android applications.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>KuDroid needs microphone access for guest Android applications and audio recording.</string>
    <key>NSMotionUsageDescription</key>
    <string>Guest Android applications can use motion sensors for tilt and movement controls.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>KuDroid needs photo library access to import/export media files with Android apps.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>KuDroid needs Bluetooth access to connect wireless game controllers.</string>
</dict>
</plist>
