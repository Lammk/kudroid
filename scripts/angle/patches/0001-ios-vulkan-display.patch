+#ifndef LIBANGLE_RENDERER_VULKAN_IOS_DISPLAYVKIOS_H_
+#define LIBANGLE_RENDERER_VULKAN_IOS_DISPLAYVKIOS_H_
+
+#include "libANGLE/renderer/vulkan/DisplayVk.h"
+
+namespace rx
+{
+class DisplayVkIOS final : public DisplayVk
+{
+  public:
+    explicit DisplayVkIOS(const egl::DisplayState &state);
+    bool isValidNativeWindow(EGLNativeWindowType window) const override;
+    SurfaceImpl *createWindowSurfaceVk(const egl::SurfaceState &state,
+                                       EGLNativeWindowType window) override;
+    egl::ConfigSet generateConfigs() override;
+    void checkConfigSupport(egl::Config *config) override;
+    const char *getWSIExtension() const override;
+};
+}
