+#ifndef LIBANGLE_RENDERER_VULKAN_IOS_WINDOWSURFACEVKIOS_H_
+#define LIBANGLE_RENDERER_VULKAN_IOS_WINDOWSURFACEVKIOS_H_
+
+#import <QuartzCore/CAMetalLayer.h>
+
+#include "libANGLE/renderer/vulkan/SurfaceVk.h"
+
+namespace rx
+{
+class WindowSurfaceVkIOS final : public WindowSurfaceVk
+{
+  public:
+    WindowSurfaceVkIOS(const egl::SurfaceState &state, EGLNativeWindowType window);
+    ~WindowSurfaceVkIOS() override;
+
+  private:
+    angle::Result createSurfaceVk(vk::ErrorContext *context) override;
+    angle::Result getCurrentWindowSize(vk::ErrorContext *context,
+                                       gl::Extents *extentsOut) const override;
+    CAMetalLayer *mMetalLayer;
+};
+}
+
+#endif
diff --git a/src/libANGLE/renderer/vulkan/ios/WindowSurfaceVkIOS.mm b/src/libANGLE/renderer/vulkan/ios/WindowSurfaceVkIOS.mm
new file mode 100644
--- /dev/null
+++ b/src/libANGLE/renderer/vulkan/ios/WindowSurfaceVkIOS.mm
@@ -0,0 +1,52 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "libANGLE/renderer/vulkan/ios/WindowSurfaceVkIOS.h"
+
+#include <cmath>
+#include <limits>
+
+#include "libANGLE/renderer/vulkan/vk_renderer.h"
+#include "libANGLE/renderer/vulkan/vk_utils.h"
+
+namespace rx
+{
+WindowSurfaceVkIOS::WindowSurfaceVkIOS(const egl::SurfaceState &state,
+                                       EGLNativeWindowType window)
+    : WindowSurfaceVk(state, window),
+      mMetalLayer([reinterpret_cast<CAMetalLayer *>(window) retain])
+{}
+
+WindowSurfaceVkIOS::~WindowSurfaceVkIOS()
+{
+    [mMetalLayer release];
+}
+
+angle::Result WindowSurfaceVkIOS::createSurfaceVk(vk::ErrorContext *context)
+{
+    ANGLE_VK_CHECK(context, mMetalLayer != nil, VK_ERROR_INITIALIZATION_FAILED);
+    // Reuse the layer already attached and sized by the window owner.
+    VkMetalSurfaceCreateInfoEXT createInfo = {};
+    createInfo.sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT;
+    createInfo.pLayer = mMetalLayer;
+    ANGLE_VK_TRY(context, VK_CALL(vkCreateMetalSurfaceEXT,
+                                  context->getRenderer()->getInstance(),
+                                  &createInfo, nullptr, &mSurface));
+    return angle::Result::Continue;
+}
+
+angle::Result WindowSurfaceVkIOS::getCurrentWindowSize(vk::ErrorContext *context,
+                                                       gl::Extents *extentsOut) const
+{
+    ANGLE_VK_CHECK(context, mMetalLayer != nil, VK_ERROR_INITIALIZATION_FAILED);
+    const CGSize size = mMetalLayer.drawableSize;
+    const double maximum = std::numeric_limits<int>::max();
+    ANGLE_VK_CHECK(context, std::isfinite(size.width) && std::isfinite(size.height) &&
+                               size.width >= 0 && size.height >= 0 &&
+                               size.width <= maximum && size.height <= maximum,
+                   VK_ERROR_INITIALIZATION_FAILED);
+    *extentsOut = gl::Extents(static_cast<int>(size.width), static_cast<int>(size.height), 1);
+    return angle::Result::Continue;
+}
+}
